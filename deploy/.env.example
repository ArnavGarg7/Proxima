# Copy this to a file named `.env` IN THE REPO ROOT on the server.
# Docker Compose auto-loads it for ${VAR} substitution. It holds deployment
# topology only — application secrets live in backend/.env (never committed).
#
#   cp deploy/.env.example .env   &&   nano .env

# Your public domain (the DuckDNS subdomain you created), no scheme.
SITE_ADDRESS=proxima-you.duckdns.org

# Full public URL — baked into the frontend bundle at build time and used as
# the CORS allow-list. Must be https and match SITE_ADDRESS.
VITE_API_URL=https://proxima-you.duckdns.org
CORS_ORIGINS=https://proxima-you.duckdns.org

# Postgres password (pick a strong value). Used by the db service and the
# DATABASE_URL the app connects with.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Bind the frontend container to loopback only — the public entrypoint is Caddy
# (80/443). Leaving this on 0.0.0.0 would expose plain HTTP; keep it on 127.0.0.1.
FRONTEND_PORT=127.0.0.1:8080

# Ingestion embedding rate limit (requests/min). 90 keeps you under the Gemini
# free-tier embed quota (~100/min).
EMBEDDING_RPM=90
